<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <RootNamespace>Demo.Browser</RootNamespace>
    <!-- Smaller download; keep reflection-driven types (YAML policy, JSON cases) intact. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.8" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Demo.Core\Demo.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="SentinelAI.Core" />
    <TrimmerRootAssembly Include="Demo.Core" />
    <TrimmerRootAssembly Include="YamlDotNet" />
  </ItemGroup>
  <!-- Same policy and cases as the server demo, compiled in: a static site can't list a folder. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Demo.Agent\sentinel.yaml" LogicalName="sentinel.yaml" />
    <EmbeddedResource Include="..\Demo.Agent\cases\*.json" Exclude="..\Demo.Agent\cases\*.local.json" LogicalName="cases/%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- The UI is shared with the server demo. -->
  <ItemGroup>
    <Content Include="..\ui\**" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
